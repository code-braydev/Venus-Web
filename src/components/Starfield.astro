---
/**
 * Deep-space backdrop, fixed behind the whole page.
 *
 * Stars are generated at build time (seeded, so the sky is stable between
 * builds) as `box-shadow` lists in viewport units: zero JS, three DOM nodes.
 */
interface Props {
  /** Softer sky for reading-heavy pages such as the docs. */
  dim?: boolean;
}

const { dim = false } = Astro.props;

function mulberry32(seed: number) {
  let a = seed;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(20261118);
// Mostly cream, a few gold and pale-blue stars.
const palette = ["#fff8e7", "#fff8e7", "#fff8e7", "#fdebc6", "#f4c25e", "#cfe0ff"];

const layer = (count: number, blur: number) =>
  Array.from({ length: count }, () => {
    const x = (rand() * 100).toFixed(2);
    const y = (rand() * 100).toFixed(2);
    const color = palette[Math.floor(rand() * palette.length)];
    return `${x}vw ${y}vh ${blur}px ${color}`;
  }).join(",");

const small = layer(110, 0);
const medium = layer(34, 0);
const large = layer(12, 2);
---

<div class:list={["starfield", { "starfield-dim": dim }]} aria-hidden="true">
  <div class="haze"></div>
  <div class="stars star-s" style={`box-shadow:${small}`}></div>
  <div class="stars star-m" style={`box-shadow:${medium}`}></div>
  <div class="stars star-l" style={`box-shadow:${large}`}></div>
</div>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    pointer-events: none;
  }
  .starfield-dim {
    opacity: 0.55;
  }

  /* Deep-space depth: a cold blue glow up top, a warm Venus haze below */
  .haze {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60vw 45vh at 88% 6%, rgb(30 58 120 / 0.16), transparent 70%),
      radial-gradient(50vw 40vh at 4% 55%, rgb(20 40 90 / 0.12), transparent 70%),
      radial-gradient(
        70vw 40vh at 55% 105%,
        color-mix(in srgb, var(--color-venus-500) 9%, transparent),
        transparent 70%
      );
  }

  .stars {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
    background: transparent;
  }
  .star-s {
    width: 1px;
    height: 1px;
    opacity: 0.8;
  }
  .star-m {
    width: 2px;
    height: 2px;
    animation: twinkle 5s ease-in-out infinite;
  }
  .star-l {
    width: 3px;
    height: 3px;
    animation: twinkle 7s ease-in-out -2s infinite;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .star-m,
    .star-l {
      animation: none;
    }
  }
</style>
