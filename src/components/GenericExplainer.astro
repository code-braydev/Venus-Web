---
import CodeBlock from "./CodeBlock.astro";
import { getDict, resolveLocale } from "../i18n";
import { getSnippets } from "../docs/snippets";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = getDict(locale);
const sn = getSnippets(locale);

---

<div class="p-8 rounded-2xl bg-ink/2 border border-ink/5">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
    <div class="space-y-6">
      <div>
        <h4
          class="text-sm font-bold text-venus-300 uppercase tracking-widest mb-2"
        >
          {t.explainer.schemaTitle}
        </h4>
        <p
          class="text-sm text-faint leading-relaxed"
          set:html={t.explainer.schemaBody}
        />
      </div>
      <div>
        <h4
          class="text-sm font-bold text-venus-300 uppercase tracking-widest mb-2"
        >
          {t.explainer.optionsTitle}
        </h4>
        <div class="space-y-3">
          <div
            class="p-3 bg-ink/5 rounded border border-ink/5 hover:border-venus-500/20 transition-colors group"
          >
            <p
              class="text-xs font-bold text-ink mb-1 group-hover:text-venus-300"
            >
              {t.explainer.requestControlsTitle}
            </p>
            <p class="text-[10px] text-faint italic">
              {t.explainer.requestControlsBody}
            </p>
          </div>
          <div
            class="p-3 bg-ink/5 rounded border border-ink/5 hover:border-venus-500/20 transition-colors group"
          >
            <p
              class="text-xs font-bold text-ink mb-1 group-hover:text-venus-300"
            >
              {t.explainer.parsingTitle}
            </p>
            <p class="text-[10px] text-faint italic">
              {t.explainer.parsingBody}
            </p>
          </div>
        </div>
      </div>
    </div>

    <CodeBlock
      code={sn.fullRequest}
      filename="request.ts"
      label={t.explainer.fullRequest}
    />
  </div>
</div>
