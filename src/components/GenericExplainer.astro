---
import CodeBlock from "./CodeBlock.astro";
import { getDict, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = getDict(locale);

const fullRequest = `await get<User>("/profile", {
  headers: { Authorization: "Bearer ..." },
  timeout: 5000,
  params: { include: ["roles"] },
  responseType: "auto",
  retry: { attempts: 2, backoffMs: 200 },
});`;
---

<div class="p-8 rounded-2xl bg-white/2 border border-white/5">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
    <div class="space-y-6">
      <div>
        <h4
          class="text-sm font-bold text-purple-300 uppercase tracking-widest mb-2"
        >
          {t.explainer.schemaTitle}
        </h4>
        <p
          class="text-sm text-purple-100/40 leading-relaxed"
          set:html={t.explainer.schemaBody}
        />
      </div>
      <div>
        <h4
          class="text-sm font-bold text-purple-300 uppercase tracking-widest mb-2"
        >
          {t.explainer.optionsTitle}
        </h4>
        <div class="space-y-3">
          <div
            class="p-3 bg-white/5 rounded border border-white/5 hover:border-purple-500/20 transition-colors group"
          >
            <p
              class="text-xs font-bold text-white mb-1 group-hover:text-purple-300"
            >
              {t.explainer.requestControlsTitle}
            </p>
            <p class="text-[10px] text-purple-100/30 italic">
              {t.explainer.requestControlsBody}
            </p>
          </div>
          <div
            class="p-3 bg-white/5 rounded border border-white/5 hover:border-purple-500/20 transition-colors group"
          >
            <p
              class="text-xs font-bold text-white mb-1 group-hover:text-purple-300"
            >
              {t.explainer.parsingTitle}
            </p>
            <p class="text-[10px] text-purple-100/30 italic">
              {t.explainer.parsingBody}
            </p>
          </div>
        </div>
      </div>
    </div>

    <CodeBlock
      code={fullRequest}
      filename="request.ts"
      label={t.explainer.fullRequest}
    />
  </div>
</div>
