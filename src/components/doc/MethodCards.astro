---
/**
 * One card per request method: HTTP verb, signature, whether it takes a body,
 * its expected status and retry default, plus chips for every option it accepts.
 */
import { getContent, resolveLocale, localizePath } from "../../i18n";
import { methodFacts, requestOptionTypes } from "../../docs/nav";
import { anchorId } from "../../docs/slug";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const c = getContent(locale);
const l = c.cards.labels;
const optionsHref = localizePath("/doc/options", locale);

const verbColor: Record<string, string> = {
  GET: "text-blue-400 border-blue-500/20 bg-blue-500/10",
  POST: "text-green-400 border-green-500/20 bg-green-500/10",
  PUT: "text-orange-400 border-orange-500/20 bg-orange-500/10",
  PATCH: "text-orange-400 border-orange-500/20 bg-orange-500/10",
  DELETE: "text-red-400 border-red-500/20 bg-red-500/10",
};
---

<div class="space-y-4">
  <p class="text-muted leading-relaxed" set:html={c.cards.methodsIntro} />
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    {
      methodFacts.map((m) => (
        <article class="flex flex-col rounded-xl border border-ink/10 bg-surface-2/60 p-4">
          <header class="flex flex-wrap items-center gap-3">
            <span
              class:list={[
                "rounded-md border px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest",
                verbColor[m.http],
              ]}
            >
              {m.http}
            </span>
            <a
              href={`#${m.anchor}`}
              class="font-mono text-sm font-bold text-venus-300 hover:text-venus-100"
            >
              {m.name}
            </a>
          </header>
          <code class="mt-2 block text-[11px] text-faint">venus.{m.sig}</code>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            {c.cards.methods[m.name]}
          </p>

          <dl class="mt-3 grid grid-cols-1 gap-1 text-[12px] sm:grid-cols-[auto_1fr] sm:gap-x-4">
            <dt class="text-accent-soft">{l.body}</dt>
            <dd class="text-copy">{m.body ? l.bodyYes : l.bodyNo}</dd>
            <dt class="text-accent-soft">{l.status}</dt>
            <dd class="font-mono text-green-400">{m.status}</dd>
            <dt class="text-accent-soft">{l.retries}</dt>
            <dd class="text-copy">{m.retries ? l.retriesYes : l.retriesNo}</dd>
          </dl>

          <div class="mt-3 border-t border-ink/5 pt-3">
            <p class="mb-2 text-[10px] font-bold uppercase tracking-widest text-accent-soft">
              {l.accepts}
            </p>
            <div class="flex flex-wrap gap-1.5">
              {requestOptionTypes
                .filter((o) => m.body || o.name !== "body")
                .map((o) => (
                  <a
                    href={`${optionsHref}#${anchorId(o.name)}`}
                    class="rounded border border-ink/10 bg-ink/5 px-1.5 py-0.5 font-mono text-[11px] text-muted transition-colors hover:border-venus-500/30 hover:text-venus-200"
                  >
                    {o.name}
                  </a>
                ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</div>
