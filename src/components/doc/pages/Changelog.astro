---
import CodeBlock from "../../CodeBlock.astro";
import { getDict, resolveLocale } from "../../../i18n";
import { getSnippets } from "../../../docs/snippets";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const d = getDict(locale).doc;
const sn = getSnippets(locale);
---

<section class="space-y-6">
  <p class="leading-relaxed text-muted" set:html={d.prose.changelog} />
  <CodeBlock
    code={sn.changelogSnippet}
    filename="CHANGELOG.md"
    lang="md"
    lines={false}
    label="History"
  />
</section>

<section id="testing" class="space-y-4">
  <h2 class="text-2xl font-bold text-ink">{d.headings.testing}</h2>
  <p class="leading-relaxed text-muted">{d.prose.testing}</p>
  <div class="btn-command w-fit px-5 py-3">
    <span class="mr-2 font-mono text-venus-400">$</span>
    <code class="font-mono text-sm">npm test</code>
  </div>
</section>

<section id="license" class="space-y-4">
  <h2 class="text-2xl font-bold text-ink">{d.headings.license}</h2>
  <p class="text-muted">{d.prose.license}</p>
</section>
