---
/** Frequently asked questions: plain <details> accordions, also exported as FAQPage JSON-LD. */
import { getContent, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const f = getContent(locale).faq;
---

<section class="section-container" id="faq">
  <div class="mb-12 max-w-2xl">
    <h2 class="mb-4 text-3xl font-bold text-ink">{f.title}</h2>
    <p class="text-balance text-faint">{f.lead}</p>
  </div>

  <div class="max-w-3xl space-y-3">
    {
      f.items.map((item) => (
        <details class="group rounded-xl border border-ink/10 bg-surface-2/60 transition-colors open:border-venus-500/30">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold text-ink marker:hidden [&::-webkit-details-marker]:hidden">
            <h3 class="text-base font-semibold">{item.q}</h3>
            <span
              aria-hidden="true"
              class="shrink-0 text-venus-300 transition-transform group-open:rotate-45"
            >
              +
            </span>
          </summary>
          <p
            class="px-5 pb-5 text-sm leading-relaxed text-muted"
            set:html={item.a}
          />
        </details>
      ))
    }
  </div>
</section>
