---
import CodeBlock from "./CodeBlock.astro";
import { getDict, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = getDict(locale);
const s = t.quickStart.steps;

const configSnippet = `import { venusConfig } from "@braydev/venus";

venusConfig.setBaseURL("https://api.braydev.xyz");`;

const headersSnippet = `import { venusConfig } from "@braydev/venus";

venusConfig.setBaseURL("https://api.braydev.xyz");

venusConfig.setGlobalHeaders({
  Authorization: "Bearer my-token",
  "X-App-Version": "2.2.2",
});

// Read the current global headers (returns a plain object)
const current = venusConfig.getGlobalHeaders();`;

const firstRequestSnippet = `import { get, send } from "@braydev/venus";

// GET with query params, timeout and smart parsing
const profile = await get<User>("/profile", {
  timeout: 8000,
  params: { include: ["roles", "permissions"] },
  paramsArrayFormat: "repeat",
  responseType: "auto",
});

if (profile.ok) {
  console.log(profile.data?.name);
} else {
  console.error(profile.errorCode, profile.error);
}

// POST with automatic retry
const created = await send("/users", { name: "Brayan" }, {
  retry: { attempts: 2, backoffMs: 200 },
});`;

const paramsSnippet = `await get("/news", {
  params: { category: "tech", limit: 5 },
});

// Result: /news?category=tech&limit=5`;

const rssSnippet = `import { getRss } from "@braydev/venus";

const feed = await getRss("https://hnrss.org/frontpage", {
  timeout: 8000,
  retry: true,
  rssMode: "strict",
});

if (feed.ok) {
  for (const item of feed.data.items) {
    console.log(item.title, item.link);
    console.log(item.image); // auto-resolved thumbnail
  }
}`;

const arrayFormats = [
  {
    mode: '"repeat" (default)',
    result: "/search?tag=js&tag=ts",
    note: t.quickStart.formats.repeat,
  },
  {
    mode: '"comma"',
    result: "/search?tag=js,ts",
    note: t.quickStart.formats.comma,
  },
  {
    mode: '"brackets"',
    result: "/search?tag[]=js&tag[]=ts",
    note: t.quickStart.formats.brackets,
  },
  {
    mode: '"indices"',
    result: "/search?tag[0]=js&tag[1]=ts",
    note: t.quickStart.formats.indices,
  },
];
---

<div class="space-y-14">
  <div class="space-y-4">
    <h3 class="text-xl font-bold text-white flex items-center gap-2">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-purple-500/20 text-purple-300 text-xs font-bold"
        >1</span
      >
      {s.baseTitle}
    </h3>
    <p
      class="text-sm text-purple-100/40 leading-relaxed"
      set:html={s.baseBody}
    />

    <CodeBlock code={configSnippet} filename="config.ts" lines={false} />

    <p
      class="text-[11px] text-purple-300/60 italic bg-purple-500/5 p-3 rounded border border-purple-500/10"
      set:html={s.baseNote}
    />
  </div>

  <div class="space-y-4">
    <h3 class="text-xl font-bold text-white flex items-center gap-2">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-purple-500/20 text-purple-300 text-xs font-bold"
        >2</span
      >
      {s.headersTitle}
    </h3>
    <p
      class="text-sm text-purple-100/40 leading-relaxed"
      set:html={s.headersBody}
    />

    <CodeBlock code={headersSnippet} filename="config.ts" />

    <p
      class="text-[11px] text-purple-300/60 italic bg-purple-500/5 p-3 rounded border border-purple-500/10"
      set:html={s.headersNote}
    />
  </div>

  <div class="space-y-4">
    <h3 class="text-xl font-bold text-white flex items-center gap-2">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-purple-500/20 text-purple-300 text-xs font-bold"
        >3</span
      >
      {s.firstTitle}
    </h3>
    <p
      class="text-sm text-purple-100/40 leading-relaxed"
      set:html={s.firstBody}
    />

    <CodeBlock code={firstRequestSnippet} filename="profile.ts" label="TypeScript" />
  </div>

  <div class="space-y-4">
    <h3 class="text-xl font-bold text-white flex items-center gap-2">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-purple-500/20 text-purple-300 text-xs font-bold"
        >4</span
      >
      {s.paramsTitle}
    </h3>
    <p
      class="text-sm text-purple-100/40 leading-relaxed"
      set:html={s.paramsBody}
    />

    <CodeBlock code={paramsSnippet} filename="news.ts" />

    <div class="space-y-3">
      <p
        class="text-sm text-purple-100/40 leading-relaxed"
        set:html={s.paramsSub}
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          arrayFormats.map((format) => (
            <div class="venus-card p-5 bg-[#0D0A11] font-mono text-xs border-purple-500/5">
              <p class="text-purple-400 italic mb-3">
                {"// paramsArrayFormat: "}
                {format.mode}
              </p>
              <p class="text-purple-100/90">
                params: &#123; tag: ["js", "ts"] &#125;
              </p>
              <p class="text-green-400 mt-2 break-all">
                &#8594; {format.result}
              </p>
              <p class="text-purple-100/40 mt-3 text-[11px] font-sans leading-relaxed">
                {format.note}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="space-y-4">
    <h3 class="text-xl font-bold text-white flex items-center gap-2">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-purple-500/20 text-purple-300 text-xs font-bold"
        >5</span
      >
      {s.rssTitle}
    </h3>
    <p
      class="text-sm text-purple-100/40 leading-relaxed"
      set:html={s.rssBody}
    />

    <CodeBlock code={rssSnippet} filename="news.ts" label="Feeds" />
  </div>
</div>
