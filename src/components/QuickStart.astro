---
import CodeBlock from "./CodeBlock.astro";
import { getDict, resolveLocale } from "../i18n";
import { getSnippets } from "../docs/snippets";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = getDict(locale);
const sn = getSnippets(locale);
const s = t.quickStart.steps;

const arrayFormats = [
  {
    mode: '"repeat" (default)',
    result: "/search?tag=js&tag=ts",
    note: t.quickStart.formats.repeat,
  },
  {
    mode: '"comma"',
    result: "/search?tag=js,ts",
    note: t.quickStart.formats.comma,
  },
  {
    mode: '"brackets"',
    result: "/search?tag[]=js&tag[]=ts",
    note: t.quickStart.formats.brackets,
  },
  {
    mode: '"indices"',
    result: "/search?tag[0]=js&tag[1]=ts",
    note: t.quickStart.formats.indices,
  },
];
---

<div class="space-y-14">
  <div class="space-y-4">
    <h3 class="text-xl font-bold text-ink flex items-center gap-2">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-venus-500/20 text-venus-300 text-xs font-bold"
        >1</span
      >
      {s.baseTitle}
    </h3>
    <p
      class="text-sm text-faint leading-relaxed"
      set:html={s.baseBody}
    />

    <CodeBlock code={sn.configSnippet} filename="config.ts" lines={false} />

    <p
      class="text-[11px] text-accent-soft italic bg-venus-500/5 p-3 rounded border border-venus-500/10"
      set:html={s.baseNote}
    />
  </div>

  <div class="space-y-4">
    <h3 class="text-xl font-bold text-ink flex items-center gap-2">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-venus-500/20 text-venus-300 text-xs font-bold"
        >2</span
      >
      {s.headersTitle}
    </h3>
    <p
      class="text-sm text-faint leading-relaxed"
      set:html={s.headersBody}
    />

    <CodeBlock code={sn.headersSnippet} filename="config.ts" />

    <p
      class="text-[11px] text-accent-soft italic bg-venus-500/5 p-3 rounded border border-venus-500/10"
      set:html={s.headersNote}
    />
  </div>

  <div class="space-y-4">
    <h3 class="text-xl font-bold text-ink flex items-center gap-2">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-venus-500/20 text-venus-300 text-xs font-bold"
        >3</span
      >
      {s.firstTitle}
    </h3>
    <p
      class="text-sm text-faint leading-relaxed"
      set:html={s.firstBody}
    />

    <CodeBlock code={sn.firstRequestSnippet} filename="profile.ts" label="TypeScript" />
  </div>

  <div class="space-y-4">
    <h3 class="text-xl font-bold text-ink flex items-center gap-2">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-venus-500/20 text-venus-300 text-xs font-bold"
        >4</span
      >
      {s.paramsTitle}
    </h3>
    <p
      class="text-sm text-faint leading-relaxed"
      set:html={s.paramsBody}
    />

    <CodeBlock code={sn.paramsSnippet} filename="news.ts" />

    <div class="space-y-3">
      <p
        class="text-sm text-faint leading-relaxed"
        set:html={s.paramsSub}
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          arrayFormats.map((format) => (
            <div class="venus-card p-5 bg-surface-3 font-mono text-xs border-venus-500/5">
              <p class="text-venus-400 italic mb-3">
                {"// paramsArrayFormat: "}
                {format.mode}
              </p>
              <p class="text-copy">
                params: &#123; tag: ["js", "ts"] &#125;
              </p>
              <p class="text-green-400 mt-2 break-all">
                &#8594; {format.result}
              </p>
              <p class="text-faint mt-3 text-[11px] font-sans leading-relaxed">
                {format.note}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="space-y-4">
    <h3 class="text-xl font-bold text-ink flex items-center gap-2">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-venus-500/20 text-venus-300 text-xs font-bold"
        >5</span
      >
      {s.clientTitle}
    </h3>
    <p
      class="text-sm text-faint leading-relaxed"
      set:html={s.clientBody}
    />

    <CodeBlock code={sn.clientSnippet} filename="clients.ts" label="Clients" />
  </div>
</div>
