---
import CodeBlock from "./CodeBlock.astro";
import { getDict, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = getDict(locale);
const s = t.quickStart.steps;

const configSnippet = `import { venus } from "@braydev/venus";

venus.config({
  baseURL: "https://api.braydev.xyz",
  timeout: 8000,
});`;

const headersSnippet = `import { venus } from "@braydev/venus";

venus.config({
  baseURL: "https://api.braydev.xyz",
  headers: { "X-App-Version": "1.0.0" },
  hooks: {
    // Runs on every attempt, retries included: always the current token
    beforeRequest: () => ({
      headers: { Authorization: "Bearer " + session.token },
    }),
  },
});

// Read the active config back
const current = venus.config();`;

const firstRequestSnippet = `import { venus } from "@braydev/venus";

// GET with query params, timeout and auto parsing
const profile = await venus.get<User>("/profile", {
  timeout: 8000,
  params: { include: ["roles", "permissions"] },
  paramsArrayFormat: "repeat",
});

if (profile.ok) {
  console.log(profile.data.name); // User: no null check needed
} else {
  console.error(profile.errorCode, profile.error);
}

// POST: the object is sent as JSON, Content-Type included
const created = await venus.send<User>("/users", { name: "Brayan" });`;

const paramsSnippet = `await venus.get("/news", {
  params: { category: "tech", limit: 5 },
});

// Result: /news?category=tech&limit=5`;

const clientSnippet = `import { createClient } from "@braydev/venus";

export const api = createClient({
  baseURL: "https://api.braydev.xyz",
  headers: { "X-App-Version": "1.0.0" },
  timeout: 8000,
});

export const cdn = createClient({
  baseURL: "https://cdn.braydev.xyz",
  timeout: 30_000,
});

const res = await api.get<User[]>("/users");
if (res.ok) console.log(res.data.length);

api.abort(); // cancel everything in flight on this client`;

const arrayFormats = [
  {
    mode: '"repeat" (default)',
    result: "/search?tag=js&tag=ts",
    note: t.quickStart.formats.repeat,
  },
  {
    mode: '"comma"',
    result: "/search?tag=js,ts",
    note: t.quickStart.formats.comma,
  },
  {
    mode: '"brackets"',
    result: "/search?tag[]=js&tag[]=ts",
    note: t.quickStart.formats.brackets,
  },
  {
    mode: '"indices"',
    result: "/search?tag[0]=js&tag[1]=ts",
    note: t.quickStart.formats.indices,
  },
];
---

<div class="space-y-14">
  <div class="space-y-4">
    <h3 class="text-xl font-bold text-ink flex items-center gap-2">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-venus-500/20 text-venus-300 text-xs font-bold"
        >1</span
      >
      {s.baseTitle}
    </h3>
    <p
      class="text-sm text-faint leading-relaxed"
      set:html={s.baseBody}
    />

    <CodeBlock code={configSnippet} filename="config.ts" lines={false} />

    <p
      class="text-[11px] text-accent-soft italic bg-venus-500/5 p-3 rounded border border-venus-500/10"
      set:html={s.baseNote}
    />
  </div>

  <div class="space-y-4">
    <h3 class="text-xl font-bold text-ink flex items-center gap-2">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-venus-500/20 text-venus-300 text-xs font-bold"
        >2</span
      >
      {s.headersTitle}
    </h3>
    <p
      class="text-sm text-faint leading-relaxed"
      set:html={s.headersBody}
    />

    <CodeBlock code={headersSnippet} filename="config.ts" />

    <p
      class="text-[11px] text-accent-soft italic bg-venus-500/5 p-3 rounded border border-venus-500/10"
      set:html={s.headersNote}
    />
  </div>

  <div class="space-y-4">
    <h3 class="text-xl font-bold text-ink flex items-center gap-2">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-venus-500/20 text-venus-300 text-xs font-bold"
        >3</span
      >
      {s.firstTitle}
    </h3>
    <p
      class="text-sm text-faint leading-relaxed"
      set:html={s.firstBody}
    />

    <CodeBlock code={firstRequestSnippet} filename="profile.ts" label="TypeScript" />
  </div>

  <div class="space-y-4">
    <h3 class="text-xl font-bold text-ink flex items-center gap-2">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-venus-500/20 text-venus-300 text-xs font-bold"
        >4</span
      >
      {s.paramsTitle}
    </h3>
    <p
      class="text-sm text-faint leading-relaxed"
      set:html={s.paramsBody}
    />

    <CodeBlock code={paramsSnippet} filename="news.ts" />

    <div class="space-y-3">
      <p
        class="text-sm text-faint leading-relaxed"
        set:html={s.paramsSub}
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          arrayFormats.map((format) => (
            <div class="venus-card p-5 bg-surface-3 font-mono text-xs border-venus-500/5">
              <p class="text-venus-400 italic mb-3">
                {"// paramsArrayFormat: "}
                {format.mode}
              </p>
              <p class="text-copy">
                params: &#123; tag: ["js", "ts"] &#125;
              </p>
              <p class="text-green-400 mt-2 break-all">
                &#8594; {format.result}
              </p>
              <p class="text-faint mt-3 text-[11px] font-sans leading-relaxed">
                {format.note}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="space-y-4">
    <h3 class="text-xl font-bold text-ink flex items-center gap-2">
      <span
        class="flex h-6 w-6 items-center justify-center rounded-full bg-venus-500/20 text-venus-300 text-xs font-bold"
        >5</span
      >
      {s.clientTitle}
    </h3>
    <p
      class="text-sm text-faint leading-relaxed"
      set:html={s.clientBody}
    />

    <CodeBlock code={clientSnippet} filename="clients.ts" label="Clients" />
  </div>
</div>
