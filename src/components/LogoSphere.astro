---
/**
 * The Venus logo (a golden wireframe sphere), fixed behind the page.
 *
 * At the top it is a huge arc rising from the bottom of the hero. As you scroll
 * it shrinks and slides to the left edge, where it stays half out of view
 * while the content cards pass in front of it. `--p` (0 -> 1) is the scroll
 * progress, written by the script below; everything else is CSS.
 *
 * The sphere is drawn as inline SVG (computed at build time), so it stays
 * sharp at any size.
 */
interface Props {
  /** Start already shrunk at the left (pages without a hero, e.g. the docs). */
  settled?: boolean;
}

const { settled = false } = Astro.props;

// --- Wireframe sphere: Fibonacci points + nearest-neighbour edges ---------
const N = 190;
const K = 5;
const R = 470;
const C = 500;
const TILT = 0.38; // radians, tilts the poles toward the viewer

type P3 = { x: number; y: number; z: number };

const golden = Math.PI * (3 - Math.sqrt(5));
const pts: P3[] = Array.from({ length: N }, (_, i) => {
  const y = 1 - (i / (N - 1)) * 2;
  const r = Math.sqrt(1 - y * y);
  const a = golden * i;
  const x0 = Math.cos(a) * r;
  const z0 = Math.sin(a) * r;
  // rotate around X by TILT
  return {
    x: x0,
    y: y * Math.cos(TILT) - z0 * Math.sin(TILT),
    z: y * Math.sin(TILT) + z0 * Math.cos(TILT),
  };
});

const dist2 = (a: P3, b: P3) =>
  (a.x - b.x) ** 2 + (a.y - b.y) ** 2 + (a.z - b.z) ** 2;

const edgeSet = new Set<string>();
pts.forEach((p, i) => {
  pts
    .map((q, j) => ({ j, d: i === j ? Infinity : dist2(p, q) }))
    .sort((a, b) => a.d - b.d)
    .slice(0, K)
    .forEach(({ j }) => edgeSet.add(i < j ? `${i}-${j}` : `${j}-${i}`));
});

const sx = (p: P3) => (C + p.x * R).toFixed(1);
const sy = (p: P3) => (C + p.y * R).toFixed(1);

const edges = [...edgeSet].map((key) => {
  const [i, j] = key.split("-").map(Number);
  const a = pts[i];
  const b = pts[j];
  return {
    d: `M${sx(a)} ${sy(a)}L${sx(b)} ${sy(b)}`,
    front: (a.z + b.z) / 2 >= 0,
  };
});

const frontEdges = edges.filter((e) => e.front).map((e) => e.d).join("");
const backEdges = edges.filter((e) => !e.front).map((e) => e.d).join("");
const nodes = pts.map((p) => ({
  cx: sx(p),
  cy: sy(p),
  front: p.z >= 0,
}));
---

<div
  class="planet-layer"
  data-planet
  data-settled={settled ? "true" : "false"}
  aria-hidden="true"
>
  <div class="planet-wrap">
    <div class="halo"></div>
    <svg class="sphere" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="sphere-body" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#151413" />
          <stop offset="78%" stop-color="#0c0b0a" />
          <stop offset="100%" stop-color="#1a140a" />
        </radialGradient>
        <radialGradient id="sphere-node">
          <stop offset="0%" stop-color="#fff6dc" />
          <stop offset="45%" stop-color="#f6cf7a" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#f4c25e" stop-opacity="0" />
        </radialGradient>
      </defs>

      <circle cx={C} cy={C} r={R} fill="url(#sphere-body)" />

      <g class="spin">
        <path d={backEdges} class="edge back" />
        <path d={frontEdges} class="edge front" />
        {
          nodes.map((n) => (
            <circle
              cx={n.cx}
              cy={n.cy}
              r={n.front ? 5 : 3}
              fill="url(#sphere-node)"
              opacity={n.front ? 0.85 : 0.3}
            />
          ))
        }
      </g>

      <circle cx={C} cy={C} r={R} class="rim" />
    </svg>
  </div>
</div>

<style>
  .planet-layer {
    --p: 0;
    position: fixed;
    inset: 0;
    z-index: -9;
    overflow: hidden;
    pointer-events: none;
  }
  .planet-layer[data-settled="true"] {
    --p: 1;
    opacity: 0.4;
  }
  /* On the docs it sits further out so the sidebar stays readable */
  .planet-layer[data-settled="true"] .planet-wrap {
    --x1: calc(-9vw - var(--d) / 2);
  }

  /* One transform moves and scales the whole sphere (halo included) */
  .planet-wrap {
    --d: clamp(820px, 170vw, 2800px);
    --cap: clamp(110px, 21vh, 280px);
    --end: 0.3;
    --x0: calc(50vw - var(--d) / 2);
    --y0: calc(100vh - var(--cap));
    --x1: calc(2vw - var(--d) / 2);
    --y1: calc(58vh - var(--d) / 2);
    position: absolute;
    top: 0;
    left: 0;
    width: var(--d);
    height: var(--d);
    transform-origin: 50% 50%;
    transform: translate3d(
        calc(var(--x0) + (var(--x1) - var(--x0)) * var(--p)),
        calc(var(--y0) + (var(--y1) - var(--y0)) * var(--p)),
        0
      )
      scale(calc(1 + (var(--end) - 1) * var(--p)));
    will-change: transform;
  }

  /* Glow: a radial ring around the sphere (no blur filters, no tiling artifacts) */
  .halo {
    --r: calc(var(--d) * 0.47);
    --h: 340px;
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(var(--d) + var(--h) * 2);
    height: calc(var(--d) + var(--h) * 2);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      circle closest-side,
      transparent calc(var(--r) - 4px),
      rgb(255 236 190 / 0.5) var(--r),
      rgb(244 194 94 / 0.25) calc(var(--r) + 36px),
      rgb(219 160 60 / 0.1) calc(var(--r) + 130px),
      transparent calc(var(--r) + var(--h))
    );
  }

  .sphere {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .edge {
    fill: none;
    stroke-linecap: round;
  }
  .edge.front {
    stroke: #f4c25e;
    stroke-width: 1.3;
    opacity: 0.5;
  }
  .edge.back {
    stroke: #c9953a;
    stroke-width: 1;
    opacity: 0.18;
  }
  .rim {
    fill: none;
    stroke: rgb(255 236 190 / 0.75);
    stroke-width: 3;
  }

  /* Slow spin of the wireframe (transform only: compositor) */
  .spin {
    transform-origin: 500px 500px;
    animation: spin 240s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* While the sphere travels, freeze the spin: fewer layers to recomposite */
  .planet-layer.moving .spin {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .spin {
      animation: none;
    }
  }
</style>

<script>
  const layer = document.querySelector<HTMLElement>("[data-planet]");
  const wrap = layer?.querySelector<HTMLElement>(".planet-wrap");

  if (layer && wrap && layer.dataset.settled !== "true") {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion) {
      // No travelling planet: it rests at the left from the start.
      layer.style.setProperty("--p", "1");
    } else {
      // Tuning knobs. The geometry mirrors the CSS custom properties of
      // `.planet-wrap` (--cap, --end, --x1, --y1): keep both in sync.
      const END_SCALE = 0.3; // final size, as a fraction of the diameter
      const END_X = 0.02; // final center x, in viewport widths
      const END_Y = 0.58; // final center y, in viewport heights
      const RANGE = 1.5; // scroll distance of the whole trip, in viewport heights
      const TAU = 150; // ms: higher = floatier, lower = more literal

      let d = wrap.offsetWidth;
      let vw = window.innerWidth;
      let vh = window.innerHeight;

      const measure = () => {
        d = wrap.offsetWidth;
        vw = window.innerWidth;
        vh = window.innerHeight;
      };

      // Smoothstep of the scroll position: gentle start, gentle landing.
      const targetAt = () => {
        const t = Math.min(1, Math.max(0, window.scrollY / (vh * RANGE)));
        return t * t * (3 - 2 * t);
      };

      const apply = (p: number) => {
        const cap = Math.min(280, Math.max(110, vh * 0.21));
        const x0 = vw / 2 - d / 2;
        const y0 = vh - cap;
        const x1 = vw * END_X - d / 2;
        const y1 = vh * END_Y - d / 2;
        const x = x0 + (x1 - x0) * p;
        const y = y0 + (y1 - y0) * p;
        const scale = 1 + (END_SCALE - 1) * p;
        wrap.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0) scale(${scale.toFixed(4)})`;
      };

      let target = targetAt();
      let current = target;
      let raf = 0;
      let last = 0;

      // The planet chases the scroll position with exponential easing, so the
      // discrete steps of a mouse wheel become one continuous glide.
      const tick = (now: number) => {
        const dt = Math.min(64, now - (last || now));
        last = now;
        current += (target - current) * (1 - Math.exp(-dt / TAU));

        if (Math.abs(target - current) < 0.0004) {
          current = target;
          raf = 0;
          last = 0;
          layer.classList.remove("moving");
        } else {
          raf = requestAnimationFrame(tick);
        }
        apply(current);
      };

      const kick = () => {
        target = targetAt();
        if (!raf) {
          layer.classList.add("moving");
          raf = requestAnimationFrame(tick);
        }
      };

      window.addEventListener("scroll", kick, { passive: true });
      window.addEventListener(
        "resize",
        () => {
          measure();
          apply(current);
          kick();
        },
        { passive: true },
      );
      apply(current);
    }
  }
</script>
