---
import CodeBlock from "./CodeBlock.astro";
import { getDict, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = getDict(locale);

interface Props {
  id: string;
  method: string;
  color: string;
  syntax: string;
  description: string;
  status: string;
  code: string;
  filename?: string;
  details?: { title: string; body: string }[];
}
const {
  id,
  method,
  color,
  syntax,
  description,
  status,
  code,
  filename = "example.ts",
  details,
} = Astro.props;
---

<div
  id={id}
  class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start scroll-mt-32 group"
>
  <div class="space-y-6">
    <div class="flex items-center gap-3">
      <span
        class={`px-3 py-1 rounded-md ${color} text-[10px] font-bold uppercase tracking-widest border border-current/20 opacity-90`}
      >
        {method}
      </span>
      <h3
        class="text-2xl font-bold text-white group-hover:text-purple-200 transition-colors"
      >
        {id}<span class="text-purple-400/50 italic text-sm font-normal ml-1"
          >&lt;T&gt;</span
        >
      </h3>
    </div>

    <p class="text-sm text-purple-100/60 leading-relaxed text-balance">
      {description}
    </p>

    <ul
      class="text-[11px] text-purple-100/30 space-y-2 font-mono bg-white/2 p-4 rounded-lg border border-white/5"
    >
      <li
        class="flex flex-col sm:flex-row justify-between gap-1 border-b border-white/5 pb-2 text-balance"
      >
        <span class="uppercase tracking-tighter text-purple-300/40"
          >{t.docMethod.syntax}</span
        >
        <span class="text-purple-200">{syntax}</span>
      </li>
      <li class="flex flex-col sm:flex-row justify-between gap-1 pt-1">
        <span class="uppercase tracking-tighter text-purple-300/40"
          >{t.docMethod.expectedStatus}</span
        >
        <span class="text-green-400 font-bold">{status}</span>
      </li>
    </ul>

    {
      details && details.length > 0 && (
        <div class="space-y-3">
          <h4 class="text-[10px] font-bold uppercase tracking-widest text-purple-300/40">
            {t.docMethod.insights}
          </h4>
          <ul class="space-y-3">
            {details.map((detail) => (
              <li
                class="text-[12px] leading-relaxed bg-purple-500/5 border border-purple-500/10 rounded-lg p-3"
              >
                <span class="text-purple-300 font-bold block mb-1">
                  {detail.title}
                </span>
                <span class="text-purple-100/50">{detail.body}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div class="relative w-full min-w-0 lg:sticky lg:top-32">
    <div
      class="absolute -inset-0.5 bg-linear-to-br from-purple-500/10 to-transparent rounded-xl blur opacity-0 group-hover:opacity-100 transition duration-500"
    >
    </div>
    <div class="relative">
      <CodeBlock code={code} filename={filename} label={t.docMethod.example} />
    </div>
  </div>
</div>
