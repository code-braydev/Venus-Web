---
import DocMethod from "./DocMethod.astro";
import GenericExplainer from "./GenericExplainer.astro";
import { getDict, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = getDict(locale);
const ins = t.insights;

const getCode = `const { data, ok, errorCode } = await get<User>("/profile", {
  params: { include: ["roles"] },
  paramsArrayFormat: "repeat",
  responseType: "auto",
  timeout: 8000,
});

if (!ok) return handleError(errorCode);
console.log(data?.name);`;

const getRssCode = `const feedResult = await getRss("https://hnrss.org/frontpage", {
  timeout: 8000,
  retry: true,
  rssMode: "strict",
});

if (feedResult.ok) {
  const item = feedResult.data.items[0];
  console.log(item?.title);
  console.log(item?.image);     // resolved thumbnail
  console.log(item?.enclosure); // raw attachment
}`;

const sendCode = `const payload = { name: "Brayan" };

await send("/users", payload, {
  retry: { attempts: 2, backoffMs: 200 },
  hooks: {
    afterResponse: () => console.log("done"),
  },
});

// File upload: application/json is NOT forced
const form = new FormData();
form.append("avatar", file);
await send("/upload", form);`;

const updateCode = `// PUT: full replacement
await update("/users/1", {
  name: "Brayan",
  email: "bray@dev.com",
  active: true,
});

// PATCH: only the fields that change
await updateOnly("/users/1", { active: false }, {
  timeout: 6000,
});`;

const removeCode = `const { ok, status } = await remove("/id/10", { retry: 1 });

// ok = true even on 204 No Content
if (ok) refreshTable(status);`;

const anatomyFields = [
  { code: "data: T | null", color: "text-purple-300", key: "data" },
  { code: "ok: boolean", color: "text-green-400", key: "ok" },
  { code: "status?: number", color: "text-blue-400", key: "status" },
  { code: "error: string | null", color: "text-red-400", key: "error" },
  { code: "errorCode", color: "text-orange-400", key: "errorCode" },
  { code: "RETRY_EXHAUSTED", color: "text-yellow-400", key: "exhausted" },
] as const;
---

<div class="space-y-32">
  <GenericExplainer />

  <section
    id="anatomy"
    class="p-8 rounded-2xl bg-purple-500/3 border border-purple-500/10 mb-20 scroll-mt-32"
  >
    <div class="flex items-center gap-3 mb-6">
      <div class="p-2 bg-purple-500/20 rounded-lg">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="text-purple-400"
          ><path
            d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
          ></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"
          ></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg
        >
      </div>
      <div>
        <h3 class="text-xl font-bold text-white">{ins.anatomyTitle}</h3>
        <p class="text-xs text-purple-100/30 uppercase tracking-widest mt-1">
          {ins.anatomyKicker}
        </p>
      </div>
    </div>

    <p
      class="text-sm text-purple-100/40 mb-8 leading-relaxed"
      set:html={ins.anatomyBody}
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        anatomyFields.map((field) => (
          <div class="p-4 rounded-xl bg-black/40 border border-white/5 hover:border-purple-500/20 transition-colors group">
            <code class:list={[field.color, "font-bold block mb-1"]}>
              {field.code}
            </code>
            <p class="text-[11px] text-purple-100/30 italic">
              {ins.anatomy[field.key]}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <DocMethod
    id="get"
    method="GET"
    color="bg-blue-500/10 text-blue-400 border-blue-500/20"
    syntax="get<T>(path, options?)"
    description={ins.descriptions.get}
    status="200 OK"
    code={getCode}
    filename="profile.ts"
    details={[
      ins.get.params,
      ins.get.arrayFormat,
      ins.get.auto,
      ins.get.modes,
      ins.get.retry,
    ]}
  />

  <DocMethod
    id="getRss"
    method="GET RSS"
    color="bg-cyan-500/10 text-cyan-400 border-cyan-500/20"
    syntax="getRss(path, options?)"
    description={ins.descriptions.getRss}
    status="200 OK"
    code={getRssCode}
    filename="feed.ts"
    details={[
      ins.getRss.strict,
      ins.getRss.lenient,
      ins.getRss.image,
      ins.getRss.media,
      ins.getRss.fields,
    ]}
  />

  <DocMethod
    id="send"
    method="POST"
    color="bg-green-500/10 text-green-400 border-green-500/20"
    syntax="send<T>(path, body, options?)"
    description={ins.descriptions.send}
    status="201 Created"
    code={sendCode}
    filename="users.ts"
    details={[
      ins.send.validation,
      ins.send.contentType,
      ins.send.serverErrors,
      ins.send.bodies,
    ]}
  />

  <DocMethod
    id="update"
    method="PUT / PATCH"
    color="bg-orange-500/10 text-orange-400 border-orange-500/20"
    syntax="update<T>(path, body, options?)"
    description={ins.descriptions.update}
    status="200 OK"
    code={updateCode}
    filename="update-user.ts"
    details={[
      ins.update.difference,
      ins.update.validation,
      ins.update.uploads,
      ins.update.errors,
    ]}
  />

  <DocMethod
    id="remove"
    method="DELETE"
    color="bg-red-500/10 text-red-400 border-red-500/20"
    syntax="remove<T>(path, options?)"
    description={ins.descriptions.remove}
    status="204 No Content"
    code={removeCode}
    filename="delete.ts"
    details={[
      ins.remove.noContent,
      ins.remove.errors,
      ins.remove.options,
      ins.remove.generic,
    ]}
  />
</div>
