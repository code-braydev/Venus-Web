---
import DocMethod from "./DocMethod.astro";
import GenericExplainer from "./GenericExplainer.astro";
import { getDict, resolveLocale } from "../i18n";
import { getSnippets } from "../docs/snippets";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = getDict(locale);
const sn = getSnippets(locale);
const ins = t.insights;

const anatomyFields = [
  { code: "data: T", color: "text-venus-300", key: "data" },
  { code: "ok: boolean", color: "text-green-400", key: "ok" },
  { code: "status?: number", color: "text-blue-400", key: "status" },
  { code: "error: string | null", color: "text-red-400", key: "error" },
  { code: "errorCode", color: "text-orange-400", key: "errorCode" },
  { code: "metrics: VenusMetrics | null", color: "text-yellow-400", key: "metrics" },
] as const;
---

<div class="space-y-32">
  <GenericExplainer />

  <section
    id="anatomy"
    class="p-8 rounded-2xl bg-venus-500/3 border border-venus-500/10 mb-20 scroll-mt-32"
  >
    <div class="flex items-center gap-3 mb-6">
      <div class="p-2 bg-venus-500/20 rounded-lg">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="text-venus-400"
          ><path
            d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
          ></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"
          ></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg
        >
      </div>
      <div>
        <h3 class="text-xl font-bold text-ink">{ins.anatomyTitle}</h3>
        <p class="text-xs text-faint uppercase tracking-widest mt-1">
          {ins.anatomyKicker}
        </p>
      </div>
    </div>

    <p
      class="text-sm text-faint mb-8 leading-relaxed"
      set:html={ins.anatomyBody}
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        anatomyFields.map((field) => (
          <div class="p-4 rounded-xl bg-space/40 border border-ink/5 hover:border-venus-500/20 transition-colors group">
            <code class:list={[field.color, "font-bold block mb-1"]}>
              {field.code}
            </code>
            <p class="text-[11px] text-faint italic">
              {ins.anatomy[field.key]}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <DocMethod
    id="get"
    method="GET"
    color="bg-blue-500/10 text-blue-400 border-blue-500/20"
    syntax="venus.get<T>(path, options?)"
    description={ins.descriptions.get}
    status="200 OK"
    code={sn.getCode}
    filename="profile.ts"
    details={[
      ins.get.params,
      ins.get.arrayFormat,
      ins.get.auto,
      ins.get.modes,
      ins.get.retry,
    ]}
  />

  <DocMethod
    id="send"
    method="POST"
    color="bg-green-500/10 text-green-400 border-green-500/20"
    syntax="venus.send<T>(path, body, options?)"
    description={ins.descriptions.send}
    status="201 Created"
    code={sn.sendCode}
    filename="users.ts"
    details={[
      ins.send.validation,
      ins.send.contentType,
      ins.send.serverErrors,
      ins.send.bodies,
    ]}
  />

  <DocMethod
    id="update"
    method="PUT / PATCH"
    color="bg-orange-500/10 text-orange-400 border-orange-500/20"
    syntax="venus.update<T>(path, body, options?)"
    description={ins.descriptions.update}
    status="200 OK"
    code={sn.updateCode}
    filename="update-user.ts"
    details={[
      ins.update.difference,
      ins.update.validation,
      ins.update.uploads,
      ins.update.errors,
    ]}
  />

  <DocMethod
    id="remove"
    method="DELETE"
    color="bg-red-500/10 text-red-400 border-red-500/20"
    syntax="venus.remove<T>(path, options?)"
    description={ins.descriptions.remove}
    status="204 No Content"
    code={sn.removeCode}
    filename="delete.ts"
    details={[
      ins.remove.noContent,
      ins.remove.errors,
      ins.remove.options,
      ins.remove.generic,
    ]}
  />
</div>
