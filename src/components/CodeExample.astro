---
import { Code } from "astro:components";
import type { ShikiTransformer } from "shiki";
import { getDict, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = getDict(locale);

const exampleCode = `import { get } from "@braydev/venus";

const { data, ok } = await get("/posts/1");

if (ok) {
  console.log(data);
}`;

const lineNumbers: ShikiTransformer = {
  line(node, line) {
    node.properties = { ...node.properties, "data-line": line };
  },
};
---

<section class="section-container">
  <div class="mb-16">
    <h2 class="text-3xl font-bold text-white mb-4 flex items-center gap-3">
      {t.codeExample.title}
      <span class="text-[10px] font-mono bg-purple-500/10 text-purple-300 border border-purple-500/20 px-2 py-0.5 rounded tracking-widest uppercase">
        {t.codeExample.badge}
      </span>
    </h2>
    <p class="text-purple-100/40 max-w-xl text-balance">
      {t.codeExample.lead}
    </p>
  </div>

  <div class="relative group">
    <div class="absolute -inset-1 bg-linear-to-r from-purple-500/20 to-fuchsia-500/20 rounded-2xl blur-xl opacity-30 group-hover:opacity-60 transition duration-1000"></div>

    <div class="relative flex flex-col lg:grid lg:grid-cols-12 overflow-hidden rounded-2xl border border-white/10 bg-[#0B080E] shadow-2xl">

      <div class="hidden lg:flex lg:col-span-1 flex-col items-center py-6 border-r border-white/5 bg-[#08050A]">
        <div class="flex flex-col gap-6 text-purple-100/20">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-purple-300 hover:text-purple-200 cursor-help transition-colors"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18"></path></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hover:text-purple-200 cursor-help transition-colors"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
          <a href="https://github.com/code-braydev/venus" target="_blank">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hover:text-purple-200 transition-colors"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
          </a>
        </div>
      </div>

      <div class="w-full lg:col-span-6 border-b lg:border-b-0 lg:border-r border-white/5 flex flex-col bg-[#0B080E]">
        <div class="code-tabbar">
          <div class="code-dots">
            <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
            <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
            <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
          </div>
          <div class="code-tab">
            <span class="code-badge">TS</span>
            <span>apiService.ts</span>
          </div>
        </div>

        <div class="code-scroll">
          <Code
            code={exampleCode}
            lang="ts"
            theme="dark-plus"
            transformers={[lineNumbers]}
          />
        </div>
      </div>

      <div class="w-full lg:col-span-5 bg-[#08050A] flex flex-col">
        <div class="px-4 py-2.5 bg-[#0D0A11]/50 border-b border-white/5 text-[10px] font-bold uppercase tracking-[0.2em] text-purple-300/40">
          {t.codeExample.console}
        </div>

        <div class="p-4 sm:p-6 flex-1 flex flex-col">
          <div class="flex items-center gap-2 mb-4 text-[10px]">
            <span class="h-2 w-2 rounded-full bg-green-400 shadow-[0_0_10px_#4ade80]"></span>
            <span class="font-bold text-green-400 uppercase tracking-wider">200 OK</span>
            <span class="text-white/20 ml-auto font-mono italic">124ms</span>
          </div>

          <pre class="code-block text-[11px] sm:text-xs bg-white/2 p-4 rounded-lg border border-white/5 shadow-inner overflow-x-auto font-mono text-purple-100/80">
<span class="text-purple-400">{</span>
  <span class="text-purple-300">"id"</span>: <span class="text-orange-300">1</span>,
  <span class="text-purple-300">"title"</span>: <span class="text-green-300">"Networking without friction"</span>,
  <span class="text-purple-300">"author"</span>: <span class="text-green-300">"braydev"</span>
<span class="text-purple-400">}</span></pre>

          <div class="mt-8 lg:mt-auto pt-6 flex items-center gap-2">
            <div class="text-[9px] text-purple-100/20 uppercase font-black tracking-tighter">{t.codeExample.systemStatus}</div>
            <div class="h-px flex-1 bg-white/5"></div>
            <div class="text-[10px] text-purple-300/60 font-mono italic animate-pulse">{t.codeExample.ready}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
